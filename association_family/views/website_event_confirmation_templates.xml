<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="association_family_payment_confirmation_participants"
              inherit_id="website_sale.payment_confirmation_status"
              priority="40">
        <xpath expr="." position="inside">
            <t t-if="order">
                <t t-set="event_lines" t-value="order.order_line.filtered(lambda l: (l._fields.get('event_id') and l.event_id) or (l._fields.get('event_ticket_id') and l.event_ticket_id))"/>
                <div t-if="event_lines" class="alert alert-secondary mt-3">
                    <h5 class="mb-3">Participants enregistres</h5>
                    <div class="d-flex flex-column gap-2">
                        <t t-foreach="event_lines" t-as="line">
                            <div class="border rounded p-2 bg-white">
                                <div class="fw-bold" t-out="line.name"/>
                                <div t-if="line.event_participant_ids">
                                    <span t-foreach="line.event_participant_ids" t-as="member" class="badge text-bg-light me-1" t-out="member.name"/>
                                </div>
                                <div t-elif="line.member_id" class="text-muted">
                                    <span t-out="line.member_id.name"/>
                                </div>
                                <div t-else="" class="text-muted">Aucun participant specifie</div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
