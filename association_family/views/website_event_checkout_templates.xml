<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="association_family_cart_event_participants"
              inherit_id="website_sale.cart"
              priority="30">
        <xpath expr="." position="inside">
            <t t-set="association_order_id" t-value="request.session.get('sale_order_id')"/>
            <t t-set="association_order" t-value="association_order_id and request.env['sale.order'].sudo().browse(association_order_id)"/>
            <div t-if="not association_order_id" class="alert alert-warning mb-3" id="association-family-no-session-order">
                Aucun panier de session detecte pour l'affectation membre.
            </div>
            <div t-elif="not association_order or not association_order.exists()" class="alert alert-warning mb-3" id="association-family-invalid-session-order">
                Le panier de session est introuvable. Videz le panier puis ajoutez un article.
            </div>
            <t t-elif="association_order and association_order.partner_id">
                <div t-if="request.env.user._is_public()" class="alert alert-info mb-3" id="association-family-login-required">
                    Connectez-vous pour attribuer les produits a un membre du menage.
                </div>
                <t t-set="manager" t-value="association_order.partner_id.parent_id or association_order.partner_id"/>
                <t t-set="household_members" t-value="(manager | manager.child_ids).filtered(lambda p: p.active)"/>
                <t t-set="event_lines" t-value="association_order.order_line.filtered(lambda l: (l._fields.get('event_id') and l.event_id) or (l._fields.get('event_ticket_id') and l.event_ticket_id))"/>

                <div t-if="association_order.order_line" id="association-family-cart-members" class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Membre beneficiaire</h5>
                        <p class="text-muted mb-3">Choisissez le membre du menage qui recoit chaque article du panier.</p>
                        <div t-if="not household_members" class="alert alert-warning mb-3">
                            Aucun membre actif n'est disponible pour ce compte.
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="association_order.order_line" t-as="line">
                                <div class="border rounded p-3">
                                    <div class="fw-bold mb-2" t-out="line.name"/>
                                    <select class="form-select js_association_family_member" t-att-data-line-id="line.id">
                                        <option value="">Sans beneficiaire</option>
                                        <t t-foreach="household_members" t-as="member">
                                            <option t-att-value="member.id"
                                                    t-att-selected="member == line.member_id and 'selected' or None"
                                                    t-out="member.name"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div t-if="household_members and event_lines" id="association-family-event-participants" class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Participants du menage</h5>
                        <p class="text-muted mb-3">Selectionnez les membres pour chaque billet evenement.</p>
                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="event_lines" t-as="line">
                                <div class="border rounded p-3">
                                    <div class="fw-bold mb-2" t-out="line.name"/>
                                    <select class="form-select js_association_family_participants" multiple="multiple" t-att-data-line-id="line.id">
                                        <t t-foreach="household_members" t-as="member">
                                            <option t-att-value="member.id"
                                                    t-att-selected="member in line.event_participant_ids and 'selected' or None"
                                                    t-out="member.name"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
