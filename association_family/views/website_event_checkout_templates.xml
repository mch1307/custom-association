<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="association_family_cart_event_participants"
              inherit_id="website_sale.cart"
              priority="30">
        <xpath expr="." position="inside">
            <t t-if="website_sale_order and not request.env.user._is_public()">
                <t t-set="manager" t-value="website_sale_order.partner_id.parent_id or website_sale_order.partner_id"/>
                <t t-set="household_members" t-value="(manager | manager.child_ids).filtered(lambda p: p.active)"/>
                <t t-set="event_lines" t-value="website_sale_order.order_line.filtered(lambda l: (l._fields.get('event_id') and l.event_id) or (l._fields.get('event_ticket_id') and l.event_ticket_id))"/>

                <div t-if="household_members and event_lines" id="association-family-event-participants" class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Participants du menage</h5>
                        <p class="text-muted mb-3">Selectionnez les membres pour chaque billet evenement.</p>

                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="event_lines" t-as="line">
                                <div class="border rounded p-3">
                                    <div class="fw-bold mb-2" t-out="line.name"/>
                                    <select class="form-select js_association_family_participants"
                                            multiple="multiple"
                                            t-att-data-line-id="line.id">
                                        <t t-foreach="household_members" t-as="member">
                                            <option t-att-value="member.id"
                                                    t-att-selected="member in line.event_participant_ids and 'selected' or None"
                                                    t-out="member.name"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
