<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_association_family" model="ir.ui.view">
        <field name="name">res.partner.form.association.family</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Household">
                    <group>
                        <group>
                            <field name="x_household_role"/>
                            <field name="x_membership_status"/>
                            <field name="x_membership_end_date"/>
                            <field name="x_household_manager_id" readonly="1"/>
                            <field name="x_household_size" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_costume_size"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
