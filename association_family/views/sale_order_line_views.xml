<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_association_family_member" model="ir.ui.view">
        <field name="name">sale.order.form.association.family.member</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="member_id"/>
                <field name="event_participant_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="member_id"/>
                <field name="event_participant_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
