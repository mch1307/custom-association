<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="association_checkout_ui_labels" inherit_id="website_sale.checkout">
        <xpath expr="//div[contains(@class, 'oe_website_sale')]" position="attributes">
            <attribute name="class" add="association_checkout_ui" separator=" "/>
        </xpath>

        <xpath expr="//button[normalize-space()='Payer maintenant']" position="replace">
            <button type="submit" class="btn btn-primary">
                Confirmer la commande
            </button>
        </xpath>

        <xpath expr="//span[normalize-space()='Paiement'] | //div[normalize-space()='Paiement'] | //h2[normalize-space()='Paiement']" position="replace">
            <span>Confirmation</span>
        </xpath>

        <xpath expr="//button[contains(@class, 'btn-primary')]" position="attributes">
            <attribute name="class" add="association_checkout_ui__primary" separator=" "/>
        </xpath>
    </template>

</odoo>
