<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="association_checkout_ui_labels" inherit_id="website_sale.checkout">

        <xpath expr="//*[normalize-space()='Payer maintenant']" position="replace">
            <button type="submit" class="btn btn-primary">
                Confirmer la commande
            </button>
        </xpath>

        <xpath expr="//*[normalize-space()='Paiement']" position="replace">
            <span>Confirmation</span>
        </xpath>

    </template>

</odoo>
